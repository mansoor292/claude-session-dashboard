# Copy to your environment (or set in systemd/session-dashboard.service).
# All are optional — sensible defaults are used when unset.

# Base wildcard domain the box is served on (one label under it becomes term./code./sessions.)
DEV_DOMAIN=dev.example.com

# Override the derived URLs individually if your layout differs:
# TERM_URL=https://term.dev.example.com
# CODE_URL=https://code.dev.example.com

# Where your git repos live (the repo dropdown scans one level deep here):
# CODE_ROOT=/home/ubuntu/Code

# Default cwd for a blank/new session (defaults to CODE_ROOT):
# REPO_DIR=/home/ubuntu/Code

# Path to the Claude Code binary:
# CLAUDE_BIN=/home/ubuntu/.local/bin/claude
