#!/usr/bin/env python3
"""Bridge a Basecamp project to the Claude session that works on it.

One project, one session. Every comment in a linked project goes to that session —
no per-thread bookkeeping, nothing to register when a new thread starts.

  bc-threads link <project> [session]    bind a project to a session (+ its webhook)
  bc-threads unlink <project>            unbind and remove the webhook
  bc-threads projects                    what this box is bridging
  bc-threads reply <recording> "text"    answer on a thread
  bc-threads watch [--dry-run] [-v]      one sweep (what bc-watch.timer runs)
  bc-threads pings / ping-reply / ping-link
  bc-threads authcheck                   warn before the OAuth token expires

Delivery is gated on the session being idle: messages are typed into its pane, so
arriving mid-turn would drop keystrokes into a running tool call. A busy session
keeps its watermark and takes the batch on the next sweep.

Site config lives in the registry (~/.claude/bc-threads.json), never in this file:
  ping_from / ping_repo_filter / ping_session / account / self
"""
import json, os, re, subprocess, sys, time, html, argparse, glob

BASECAMP = os.environ.get("BASECAMP_BIN", os.path.expanduser("~/.local/bin/basecamp"))
TMUX     = os.environ.get("TMUX_BIN", "/usr/bin/tmux")
SOCKET   = os.environ.get("TMUX_SOCKET", "default")
STORE    = os.path.expanduser(os.environ.get("BC_THREADS_FILE", "~/.claude/bc-threads.json"))
HISTORY  = os.path.expanduser(os.environ.get("BC_HISTORY_FILE", "~/.claude/bc-history.jsonl"))
HOOKSNAP = os.path.expanduser(os.environ.get("BC_HOOKS_FILE", "~/.claude/bc-hooks.json"))
CODE_ROOT = os.path.expanduser(os.environ.get("CODE_ROOT", "~/Code"))
FOOTER   = "\u2014 via Claude session"                  # marks our own pre-agent-account posts
MAXLEN   = int(os.environ.get("BC_MAXLEN", "6000"))     # per comment/ping line
BATCHMAX = int(os.environ.get("BC_BATCHMAX", "24000"))  # whole delivery
HISTLEN  = int(os.environ.get("BC_HISTLEN", "4000"))    # what /basecamp stores
SWEEP    = int(os.environ.get("BC_SWEEP", "100"))       # comments pulled per sweep
PING_FROM = []                                          # no sender allowlist by default

# What a session does with a delivered message — one wording for comments and pings.
_RULE = (
    "HANDLE IT: first decide whether the ask is fully specified. Anything you would have to "
    "guess at \u2014 scope, which repo or file, what done looks like, an unstated assumption "
    "\u2014 means it is not. Do NOT start work on an ill-formed ask. "
    "Instead ask the person back on the thread: numbered, specific questions, everything you "
    "need in ONE reply, via bc-threads %s. Do not ask what you could answer yourself by "
    "reading the code or the thread. Their answers come back to you here. Once the ask is "
    "fully clear \u2014 straight away if it already was \u2014 do the work, then report back "
    "the same way."
)
HANDLE_RULE = _RULE % 'reply <the recording id shown above> "your questions"'
PING_HANDLE_RULE = _RULE % 'ping-reply %s "your questions"'


# ---- registry -------------------------------------------------------------
def load():
    try:
        with open(STORE) as f: reg = json.load(f)
    except Exception:
        reg = {}
    reg.setdefault("projects", {})
    reg.setdefault("pings", {})
    old = reg.pop("threads", None)
    if old:                       # migrate: a project's session is whoever owned its threads
        for t in old.values():
            proj = str(t.get("project") or "")
            if not proj or not t.get("session"): continue
            rec = reg["projects"].setdefault(proj, {"connected": int(time.time())})
            rec.setdefault("session", t["session"])
            rec["last_comment_id"] = max(int(rec.get("last_comment_id") or 0),
                                         int(t.get("last_comment_id") or 0))
        save(reg)
        print("migrated %d thread link(s) into %d project link(s)" % (len(old), len(reg["projects"])),
              file=sys.stderr)
    return reg


def save(reg):
    os.makedirs(os.path.dirname(STORE), exist_ok=True)
    tmp = STORE + ".tmp"
    with open(tmp, "w") as f: json.dump(reg, f, indent=1, sort_keys=True)
    os.replace(tmp, STORE)                        # atomic: a crashed write never truncates


def note(kind, **kw):
    try:
        with open(HISTORY, "a") as f:
            f.write(json.dumps(dict(ts=int(time.time()), kind=kind, **kw)) + "\n")
    except Exception: pass


# ---- basecamp cli ---------------------------------------------------------
def bc(*args, check=True):
    """Run the CLI, return the envelope's .data. Absolute path: systemd lacks ~/.local/bin."""
    p = subprocess.run([BASECAMP, *args, "--json"], capture_output=True, text=True, timeout=180)
    if p.returncode != 0:
        if not check: return None
        sys.exit("basecamp %s failed: %s" % (" ".join(args), (p.stderr or p.stdout)[:400]))
    try: env = json.loads(p.stdout)
    except Exception:
        if not check: return None
        sys.exit("basecamp %s: unparseable output" % " ".join(args))
    if not env.get("ok") and check:
        sys.exit("basecamp %s: %s" % (" ".join(args), str(env)[:400]))
    return env.get("data")


def whoami(reg):
    """The person id we post as, so our own comments never come back at us."""
    me = reg.get("self") or {}
    if me.get("id"): return me
    d = bc("people", "show", "me", check=False) or {}
    if d.get("id"):
        reg["self"] = {"id": int(d["id"]), "name": d.get("name") or "", "checked": int(time.time())}
        save(reg)
        return reg["self"]
    return {}


def account_id(reg):
    if os.environ.get("BC_ACCOUNT"): return os.environ["BC_ACCOUNT"]
    if reg.get("account"): return reg["account"]
    d = bc("accounts", "list", check=False) or []
    if d:
        reg["account"] = str(d[0].get("id") or ""); save(reg)
        return reg["account"]
    return ""


def parse_duration(txt):
    m = re.findall(r"(\d+(?:\.\d+)?)\s*([dhms])", str(txt or ""))
    if not m: return None
    mult = {"d": 24.0, "h": 1.0, "m": 1 / 60.0, "s": 1 / 3600.0}
    return sum(float(v) * mult[u] for v, u in m)


# ---- sessions -------------------------------------------------------------
def sessions():
    """tmux session name -> {alive, status, bridge} from every account's registry."""
    out = {}
    for f in glob.glob(os.path.expanduser("~/.claude*/sessions/*.json")):
        try: d = json.load(open(f))
        except Exception: continue
        name = (d.get("tmux", "") or "").split(":")[0]
        if not name or not d.get("sessionId"): continue
        pid = d.get("pid")
        alive = bool(pid and os.path.exists("/proc/%d" % pid))
        cur = out.get(name)
        if cur is None or (alive and not cur["alive"]):
            out[name] = {"alive": alive, "status": d.get("status") or "",
                         "bridge": d.get("bridgeSessionId") or ""}
    return out


def tmux_has(name):
    return subprocess.run([TMUX, "-L", SOCKET, "has-session", "-t", "=" + name],
                          capture_output=True).returncode == 0


def ensure_bridge(name, wait=30):
    """Without Remote Control the message lands in the pane but is invisible from
    claude.ai or a phone, so turn it on before delivering rather than after."""
    if sessions().get(name, {}).get("bridge"): return True
    subprocess.run([TMUX, "-L", SOCKET, "send-keys", "-t", name, "-l", "/remote-control"], check=False)
    time.sleep(0.4)
    subprocess.run([TMUX, "-L", SOCKET, "send-keys", "-t", name, "Enter"], check=False)
    for _ in range(wait):
        time.sleep(1)
        if sessions().get(name, {}).get("bridge"): return True
    return False


def deliver(name, text):
    """Type one line, then Enter. A newline would submit early, so flatten."""
    line = " ".join(text.split())
    subprocess.run([TMUX, "-L", SOCKET, "send-keys", "-t", name, "-l", line], check=True)
    time.sleep(0.4)
    subprocess.run([TMUX, "-L", SOCKET, "send-keys", "-t", name, "Enter"], check=True)


def ready(sess, live, label):
    """Deliverable now? Holding beats dropping keystrokes into a running tool call."""
    info = live.get(sess, {})
    if not sess:
        print("-- %s: no session linked \u2014 holding" % label); return False
    if not info.get("alive"):
        print("-- %s: session %s is not running \u2014 holding" % (label, sess))
        note("hold", title=label, session=sess, why="session not running"); return False
    if info.get("status") == "busy":
        print("-- %s: %s is busy \u2014 holding" % (label, sess))
        note("hold", title=label, session=sess, why="session busy"); return False
    return True


# ---- text -----------------------------------------------------------------
def detag(s):
    s = re.sub(r"<bc-attachment[^>]*>.*?</bc-attachment>", " [attachment] ", s or "", flags=re.S)
    s = re.sub(r"<br\s*/?>|</p>", " ", s)
    s = re.sub(r"<[^>]+>", "", s)
    return re.sub(r"\s+", " ", html.unescape(s)).strip()


def clip(text, n, url=""):
    """Shorten only when we must, and never quietly."""
    text = text or ""
    if len(text) <= n: return text
    return text[:n] + " \u2026[CUT after %d of %d chars%s]" % (
        n, len(text), (" \u2014 full text: " + url) if url else "")


def recording_id(ref):
    if str(ref).isdigit(): return str(ref)
    d = bc("url", "parse", str(ref))
    return str((d or {}).get("recording_id") or "")


def cur_session():
    p = subprocess.run([TMUX, "display-message", "-p", "#{session_name}"], capture_output=True, text=True)
    return p.stdout.strip() if p.returncode == 0 else ""


# ---- the project webhook --------------------------------------------------
def hook_url():
    try:
        return subprocess.run([os.environ.get("BC_HOOK_BIN", "/usr/local/bin/bc-hook"), "--print-url"],
                              capture_output=True, text=True, timeout=30).stdout.strip()
    except Exception:
        return ""


def connect_hook(project, rec):
    url = hook_url()
    if not url:
        print("!! no webhook url (is bc-hook installed?)"); return False
    for h in bc("webhooks", "list", "--in", project, check=False) or []:
        if (h.get("payload_url") or "").rstrip("/") == url.rstrip("/"):
            rec["hook_id"] = h.get("id"); rec["active"] = h.get("active"); return True
    d = bc("webhooks", "create", url, "--in", project, "--types", "Comment", check=False)
    if not d:
        print("!! could not create webhook for project %s" % project); return False
    rec["hook_id"] = d.get("id"); rec["active"] = True
    print("   webhook %s created for project %s" % (d.get("id"), project))
    return True


def remove_hook(project):
    url, gone = hook_url(), []
    for h in bc("webhooks", "list", "--in", project, check=False) or []:
        if (h.get("payload_url") or "").rstrip("/") == url.rstrip("/"):
            if bc("webhooks", "delete", str(h["id"]), "--in", project, check=False) is not None:
                gone.append(str(h["id"]))
    return gone


def sweep_comments(limit):
    """Every recent comment across the account, newest first \u2014 one call covers all projects."""
    return bc("comments", "list", "--all-projects", "--limit", str(limit), check=False) or []


# ---- commands -------------------------------------------------------------
def cmd_link(a):
    reg = load()
    project = str(a.project)
    sess = a.session or cur_session()
    if not sess: sys.exit("no session given and not running inside tmux")
    if not tmux_has(sess): sys.exit("no such session: %s" % sess)
    rec = reg["projects"].get(project) or {"connected": int(time.time())}
    rec["session"] = sess
    connect_hook(project, rec)
    if not rec.get("last_comment_id"):
        # Start from now: linking a project should not replay its whole history.
        ids = [int(c["id"]) for c in sweep_comments(SWEEP)
               if str((c.get("bucket") or {}).get("id")) == project]
        rec["last_comment_id"] = max(ids) if ids else 0
    reg["projects"][project] = rec
    save(reg)
    note("link", project=project, session=sess, text="project linked to session")
    print("project %s -> %s (from comment %s)" % (project, sess, rec["last_comment_id"]))


def cmd_unlink(a):
    reg = load()
    project = str(a.project)
    rec = reg["projects"].pop(project, None)
    if rec is None: sys.exit("project %s is not linked" % project)
    gone = [] if a.keep_hook else remove_hook(project)
    save(reg)
    note("unlink", project=project, session=rec.get("session") or "",
         text="unlinked" + ((", removed webhook " + ", ".join(gone)) if gone else ""))
    print("project %s unlinked%s" % (project, (" (webhook %s removed)" % ", ".join(gone)) if gone else ""))


def cmd_projects(a):
    reg = load(); live = sessions()
    if not reg["projects"]: print("no projects linked"); return
    for proj, rec in sorted(reg["projects"].items()):
        s = live.get(rec.get("session") or "", {})
        state = ("alive/" + (s.get("status") or "?")) if s.get("alive") else "GONE"
        print("%-12s -> %-28s [%s]  webhook %-9s  last=%s"
              % (proj, rec.get("session") or "-", state, rec.get("hook_id") or "none",
                 rec.get("last_comment_id") or 0))


def cmd_watch(a):
    reg = load(); me = whoami(reg); live = sessions()
    if not a.no_pings:
        try: cmd_pings(argparse.Namespace(to=None, dry_run=a.dry_run, verbose=a.verbose))
        except Exception as e: print("!! ping sweep failed: %s" % e)
    if not reg["projects"]:
        if a.verbose: print("no projects linked")
        return
    comments = sweep_comments(a.limit)
    per = {}
    for c in comments:
        proj = str((c.get("bucket") or {}).get("id") or "")
        if proj in reg["projects"]: per.setdefault(proj, []).append(c)
    dirty = False
    for proj, rec in sorted(reg["projects"].items()):
        cs = sorted(per.get(proj, []), key=lambda c: int(c["id"]))
        if not cs:
            if a.verbose: print("   %s: nothing in this sweep" % proj)
            continue
        seen = int(rec.get("last_comment_id") or 0)
        ours, mine = set(rec.get("ours") or []), me.get("id")
        fresh = [c for c in cs if int(c["id"]) > seen and int(c["id"]) not in ours
                 and FOOTER not in (c.get("content") or "")
                 and not (mine and (c.get("creator") or {}).get("id") == mine)]
        newest = max(int(c["id"]) for c in cs)
        if not fresh:
            if newest > seen: rec["last_comment_id"] = newest; dirty = True
            if a.verbose: print("   %s: nothing new" % proj)
            continue
        sess = rec.get("session") or ""
        if not ready(sess, live, "project " + proj): continue
        parts = []
        for c in fresh:
            par = c.get("parent") or {}
            who = (c.get("creator") or {}).get("name") or "someone"
            parts.append('[thread %s "%s"] %s: "%s" %s'
                         % (par.get("id") or "?", (par.get("title") or "")[:60], who,
                            clip(detag(c.get("content")), MAXLEN, c.get("app_url") or ""),
                            c.get("app_url") or ""))
        msg = clip("Basecamp \u2014 %d new comment(s) in project %s. %s %s"
                   % (len(fresh), proj, "  ".join(parts), HANDLE_RULE), BATCHMAX)
        if a.dry_run:
            print("   would deliver to %s (%d chars):\n%s" % (sess, len(msg), msg)); continue
        if not ensure_bridge(sess):
            print("!! %s: no Remote Control bridge \u2014 delivering, but it will not show in claude.ai" % sess)
        deliver(sess, msg)
        bridge = sessions().get(sess, {}).get("bridge") or ""
        print("-> %s: delivered %d comment(s) from project %s%s"
              % (sess, len(fresh), proj, ("  https://claude.ai/code/" + bridge) if bridge else ""))
        for c in fresh:
            par = c.get("parent") or {}
            note("comment", project=proj, thread=str(par.get("id") or ""),
                 title=par.get("title") or "", session=sess,
                 frm=(c.get("creator") or {}).get("name") or "", cid=str(c["id"]),
                 url=c.get("app_url") or "", bridge=bridge,
                 text=clip(detag(c.get("content")), HISTLEN))
        rec["last_comment_id"] = max(int(c["id"]) for c in fresh); dirty = True
    if dirty: save(reg)


def cmd_reply(a):
    reg = load()
    rid = recording_id(a.recording)
    sess = a.session or cur_session()
    d = bc("comments", "create", rid, a.text, *(["--in", a.project] if a.project else [])) or {}
    if d.get("id"):
        # Belt and braces: the author filter already covers our own comments.
        for rec in reg["projects"].values():
            rec.setdefault("ours", []).append(int(d["id"]))
        save(reg)
    note("sent", thread=rid, session=sess or "", cid=str(d.get("id") or ""), text=clip(a.text, HISTLEN))
    print("replied %s" % d.get("id", "?"))


# ---- pings (Basecamp has no webhook event type for them) ------------------
def repo_choices(pattern=""):
    out = []
    for base in (CODE_ROOT, CODE_ROOT + "/catalogs", CODE_ROOT + "/.worktrees"):
        try: entries = sorted(os.listdir(base))
        except Exception: continue
        for e in entries:
            full = os.path.join(base, e)
            if pattern and pattern.lower() not in e.lower(): continue
            if os.path.isdir(full) and os.path.exists(os.path.join(full, ".git")):
                out.append(full)
    return out


def cmd_pings(a):
    reg = load(); me = whoami(reg); live = sessions()
    seen = reg.setdefault("pings", {})
    d = bc("notifications", "list", check=False) or {}
    items = ((d.get("unreads") or []) + (d.get("reads") or [])) if isinstance(d, dict) else []
    circles = {}
    for r in items:
        if r.get("section") != "pings": continue
        m = re.search(r"/buckets/(\d+)/recordings/(\d+)/", r.get("subscription_url") or "")
        if m: circles[m.group(1)] = {"chat": m.group(2), "who": r.get("bucket_name") or "",
                                     "url": r.get("app_url") or ""}
    # Notifications carry only UNREAD items, so a thread drops out of discovery once read.
    # Keep polling every circle already known.
    for circle, st in list(seen.items()):
        if circle in circles or not st.get("chat"): continue
        circles[circle] = {"chat": st["chat"], "who": st.get("who") or "",
                           "url": st.get("url") or ("https://app.basecamp.com/%s/circles/%s"
                                                    % (account_id(reg), circle))}
    if not circles:
        if a.verbose: print("no ping threads known or in notifications")
        return
    target = a.to or reg.get("ping_session") or "_dashboard"
    for circle, info in sorted(circles.items()):
        lines = bc("api", "get", "/buckets/%s/chats/%s/lines.json" % (circle, info["chat"]), check=False)
        if not isinstance(lines, list) or not lines: continue
        if circle not in seen:
            seen[circle] = {"last_line_id": 0, "who": info["who"], "chat": info["chat"],
                            "url": info.get("url") or ""}
            save(reg)
        st = seen[circle]; st["chat"] = info["chat"]
        allow = [x.lower() for x in (reg.get("ping_from") or PING_FROM)]
        last = int(st.get("last_line_id") or 0)
        fresh = []
        for l in sorted(lines, key=lambda l: int(l["id"])):
            if int(l["id"]) <= last: continue
            if me.get("id") and (l.get("creator") or {}).get("id") == me["id"]: continue
            who = (l.get("creator") or {}).get("name") or ""
            if allow and who.lower() not in allow:
                print("   ignoring ping line from %s (not in ping_from)" % (who or "?")); continue
            fresh.append(l)
        newest = max(int(l["id"]) for l in lines)
        if not fresh:
            if newest > last: st["last_line_id"] = newest; save(reg)
            if a.verbose: print("   ping %s: nothing new" % info["who"])
            continue
        sess = st.get("session") or target
        if not ready(sess, live, "ping " + info["who"]): continue
        repos = [] if st.get("session") else repo_choices(reg.get("ping_repo_filter") or "")
        offer = ((" This ping is not linked to a checkout yet. Offer these and ask which it belongs to: "
                  + ", ".join(os.path.basename(r) for r in repos)
                  + ". Then: bc-threads ping-link " + circle + " <session>.") if repos else "")
        body = "  ".join('%s: "%s"' % ((l.get("creator") or {}).get("name") or "?",
                                       clip(detag(l.get("content")), MAXLEN, info["url"]))
                         for l in fresh)
        msg = clip("Basecamp ping \u2014 %d new message(s) from %s. %s Thread: %s .%s %s"
                   % (len(fresh), info["who"], body, info["url"], offer,
                      PING_HANDLE_RULE % circle), BATCHMAX)
        if a.dry_run:
            print("   would deliver to %s:\n%s" % (sess, msg)); continue
        ensure_bridge(sess); deliver(sess, msg)
        st["last_line_id"] = max(int(l["id"]) for l in fresh); save(reg)
        print("-> %s: delivered %d ping line(s) from %s" % (sess, len(fresh), info["who"]))
        for l in fresh:
            note("ping", circle=circle, title=info["who"], session=sess,
                 frm=(l.get("creator") or {}).get("name") or "", cid=str(l["id"]),
                 url=info["url"], text=clip(detag(l.get("content")), HISTLEN))


def cmd_ping_reply(a):
    reg = load()
    st = (reg.get("pings") or {}).get(str(a.circle))
    chat = a.chat or (st or {}).get("chat")
    if not chat: sys.exit("unknown chat for circle %s \u2014 run `bc-threads pings` first" % a.circle)
    sess = a.session or cur_session()
    # Chat lines are PLAIN TEXT: an HTML wrapper comes back escaped and the reader sees tags.
    bc("api", "post", "/buckets/%s/chats/%s/lines.json" % (a.circle, chat),
       "--data", json.dumps({"content": a.text}))
    note("sent", circle=str(a.circle), title=(st or {}).get("who") or "", session=sess or "",
         text=clip(a.text, HISTLEN))
    print("ping sent to circle %s" % a.circle)


def cmd_ping_link(a):
    reg = load()
    st = (reg.setdefault("pings", {})).get(str(a.circle))
    if st is None: sys.exit("circle %s is not known \u2014 run `bc-threads pings` first" % a.circle)
    if not tmux_has(a.session): sys.exit("no such session: %s" % a.session)
    st["session"] = a.session; save(reg)
    print("ping circle %s now routes to %s" % (a.circle, a.session))


# ---- housekeeping ---------------------------------------------------------
def cmd_hooks(a):
    """Reconcile every linked project's webhook, and snapshot it for the dashboard."""
    reg = load(); url = hook_url()
    if not url: sys.exit("could not work out the webhook url (is bc-hook installed?)")
    snap = {"url": url, "checked": int(time.time()), "projects": {}}
    for proj, rec in sorted(reg["projects"].items()):
        if a.dry_run:
            print("  %s: would reconcile" % proj)
        else:
            connect_hook(proj, rec)
            print("  %s: webhook %s" % (proj, rec.get("hook_id") or "FAILED"))
        snap["projects"][proj] = [
            {"id": h.get("id"), "active": h.get("active"), "types": h.get("types") or [],
             "url": h.get("payload_url") or "",
             "mine": (h.get("payload_url") or "").rstrip("/") == url.rstrip("/")}
            for h in (bc("webhooks", "list", "--in", proj, check=False) or [])]
    if not a.dry_run: save(reg)
    try:
        with open(HOOKSNAP, "w") as f: json.dump(snap, f, indent=1)
    except Exception as e: print("!! could not write hook snapshot: %s" % e)


def cmd_authcheck(a):
    d = bc("auth", "status", check=False) or {}
    hours = parse_duration(d.get("expires_in"))
    ok = d.get("authenticated") and not d.get("expired")
    if ok and hours is not None and hours > a.warn_hours:
        if a.verbose: print("basecamp auth ok \u2014 %.0fh left" % hours)
        return
    msg = ("Basecamp auth has EXPIRED \u2014 bc-watch cannot poll and replies are not reaching "
           "sessions. Run: basecamp auth login (then paste the callback URL here).") if not ok else (
          "Basecamp auth expires in about %.0f hours. Re-auth before it lapses or thread replies "
          "stop routing: basecamp auth login (then paste the callback URL here)." % (hours or 0))
    print("!!", msg)
    live = sessions()
    if a.notify and live.get(a.notify, {}).get("alive") and live[a.notify].get("status") != "busy":
        try: deliver(a.notify, msg); print("-> notified %s" % a.notify)
        except Exception as e: print("!! could not notify %s: %s" % (a.notify, e))


p = argparse.ArgumentParser(prog="bc-threads", description=__doc__,
                            formatter_class=argparse.RawDescriptionHelpFormatter)
sub = p.add_subparsers(dest="cmd", required=True)
sp = sub.add_parser("link"); sp.add_argument("project"); sp.add_argument("session", nargs="?")
sp.set_defaults(fn=cmd_link)
sp = sub.add_parser("unlink"); sp.add_argument("project")
sp.add_argument("--keep-hook", action="store_true"); sp.set_defaults(fn=cmd_unlink)
sp = sub.add_parser("projects"); sp.set_defaults(fn=cmd_projects)
sp = sub.add_parser("watch"); sp.add_argument("--dry-run", action="store_true")
sp.add_argument("--no-pings", action="store_true"); sp.add_argument("--limit", type=int, default=SWEEP)
sp.add_argument("-v", "--verbose", action="store_true"); sp.set_defaults(fn=cmd_watch)
sp = sub.add_parser("reply"); sp.add_argument("recording"); sp.add_argument("text")
sp.add_argument("-p", "--project"); sp.add_argument("-s", "--session"); sp.set_defaults(fn=cmd_reply)
sp = sub.add_parser("pings"); sp.add_argument("--to"); sp.add_argument("--dry-run", action="store_true")
sp.add_argument("-v", "--verbose", action="store_true"); sp.set_defaults(fn=cmd_pings)
sp = sub.add_parser("ping-reply"); sp.add_argument("circle"); sp.add_argument("text")
sp.add_argument("--chat"); sp.add_argument("-s", "--session"); sp.set_defaults(fn=cmd_ping_reply)
sp = sub.add_parser("ping-link"); sp.add_argument("circle"); sp.add_argument("session")
sp.set_defaults(fn=cmd_ping_link)
sp = sub.add_parser("hooks"); sp.add_argument("--dry-run", action="store_true"); sp.set_defaults(fn=cmd_hooks)
sp = sub.add_parser("authcheck"); sp.add_argument("--warn-hours", type=float, default=48.0)
sp.add_argument("--notify", default="_dashboard"); sp.add_argument("-v", "--verbose", action="store_true")
sp.set_defaults(fn=cmd_authcheck)

a = p.parse_args()
a.fn(a)
