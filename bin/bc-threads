sp.add_argument("--chat"); sp.add_argument("-s", "--session"); sp.set_defaults(fn=cmd_ping_reply)
sp = sub.add_parser("ping-link"); sp.add_argument("circle"); sp.add_argument("session")
sp.set_defaults(fn=cmd_ping_link)
sp = sub.add_parser("sync"); sp.add_argument("recording", nargs="?")
sp.add_argument("-p", "--project"); sp.set_defaults(fn=cmd_sync)
sp = sub.add_parser("orphans"); sp.set_defaults(fn=cmd_orphans)
sp = sub.add_parser("spawn", help="give a thread a session of its own (fresh, from the client document)")
sp.add_argument("thread"); sp.add_argument("--from", dest="frm", help="session whose cwd/account the child takes"); sp.add_argument("--project")
sp.set_defaults(fn=cmd_spawn)
sp = sub.add_parser("topic", help="declare a session the home for a topic (may own several threads) — a person's act")
sp.add_argument("session"); sp.add_argument("topic", nargs="?"); sp.add_argument("--by", default="Mansoor Razzaq"); sp.add_argument("--off", action="store_true")
sp.set_defaults(fn=cmd_topic)
sp = sub.add_parser("audit", help="one thread per session: report any session owning more than one")
sp.add_argument("--notify", help="also ping this session when the rule is broken"); sp.set_defaults(fn=cmd_audit)
sp = sub.add_parser("gap", help="record what the client document should have told this session")
sp.add_argument("thread"); sp.add_argument("text"); sp.add_argument("--project"); sp.add_argument("--notify", default="_dashboard")
sp.set_defaults(fn=cmd_gap)
sp = sub.add_parser("gaps", help="list recorded client-document gaps"); sp.set_defaults(fn=cmd_gaps)
sp = sub.add_parser("client-doc", help="register the document a project's fresh sessions are seeded with")
sp.add_argument("project", nargs="?"); sp.add_argument("path", nargs="?"); sp.set_defaults(fn=cmd_client_doc)
sp = sub.add_parser("orphancheck")
