sp = sub.add_parser("places"); sp.set_defaults(fn=cmd_places)
sp = sub.add_parser("watch"); sp.add_argument("--dry-run", action="store_true")
sp.add_argument("--no-pings", action="store_true"); sp.add_argument("--no-mentions", action="store_true")
sp.add_argument("--limit", type=int, default=SWEEP)
sp.add_argument("--notify", default="_dashboard")   # where "nobody owns this" is announced
sp.add_argument("-v", "--verbose", action="store_true"); sp.set_defaults(fn=cmd_watch)
sp = sub.add_parser("reply"); sp.add_argument("recording"); sp.add_argument("text")
sp.add_argument("-p", "--project"); sp.add_argument("-s", "--session")
sp.add_argument("--no-track", action="store_true")
