#!/usr/bin/env bash
# fork-tmux [new-name] [--from <session>] [--cwd <dir>]
#
# Fork the CURRENT Claude session into a new tmux session on this box: same working
# directory, the whole transcript up to now, Remote Control on, listed on the dashboard,
# covered by sleep/wake, restore and the Basecamp bridge — unlike the desktop app's fork,
# which lands in a background-daemon process outside all of that (2026-10-29).
#
# Run from inside a session (the /fork-tmux skill does), or name the source with --from.
set -euo pipefail
API="${DASHBOARD_URL:-http://127.0.0.1:5000}"
NAME=""; FROM=""; CWD=""
while [ $# -gt 0 ]; do case "$1" in
  --from) FROM="$2"; shift 2;;
  --cwd)  CWD="$2"; shift 2;;
  -h|--help) sed -n '2,10p' "$0"; exit 0;;
  *) NAME="$1"; shift;;
esac; done
if [ -z "$FROM" ]; then
  FROM="$(tmux display-message -p '#S' 2>/dev/null || true)"
  [ -n "$FROM" ] || { echo "fork-tmux: not inside a tmux session — pass --from <session>" >&2; exit 1; }
fi
case "$FROM" in _*) echo "fork-tmux: $FROM is an internal session; it is not forked" >&2; exit 1;; esac
if [ -z "$NAME" ]; then
  base="$(printf '%s' "$FROM" | cut -c1-30)"; n=2
  NAME="${base}-fork"; while tmux has-session -t "=$NAME" 2>/dev/null; do NAME="${base}-fork${n}"; n=$((n+1)); done
fi
NAME="$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9_-' '-' | cut -c1-40)"
q="name=$(printf '%s' "$FROM" | sed 's/ /%20/g')&as=$NAME&force=1"
[ -n "$CWD" ] && q="$q&cwd=$(printf '%s' "$CWD" | sed 's#/#%2F#g')"
# force=1: the caller IS mid-turn (it is running this command); the transcript on disk holds
# everything up to this point, which is exactly what the fork should carry.
res="$(curl -s -X POST "$API/api/fork?$q")"
ok="$(printf '%s' "$res" | python3 -c 'import json,sys; d=json.load(sys.stdin); print("1" if d.get("ok") else d.get("err","failed"))')"
[ "$ok" = 1 ] || { echo "fork-tmux: $ok" >&2; exit 1; }
cwd="$(printf '%s' "$res" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("cwd",""))')"
link=""
for i in $(seq 1 40); do
  sleep 2
  link="$(curl -s "$API/api/bridge?name=$NAME" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("bridge") or "")' 2>/dev/null || true)"
  [ -n "$link" ] && break
done
echo "forked $FROM -> $NAME"
echo "  cwd:     $cwd"
echo "  tmux:    $NAME   (dashboard card, sleep/wake, restore all apply)"
if [ -n "$link" ]; then echo "  link:    https://claude.ai/code/$link"; else echo "  link:    (Remote Control still connecting — see the dashboard card)"; fi
echo "  history: the whole conversation up to this point. The fork owns no Basecamp thread;"
echo "           bind one with: bc-threads track <thread> $NAME"
