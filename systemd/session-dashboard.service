[Unit]
Description=Claude session dashboard
After=network.target

[Service]
User=ubuntu
Group=ubuntu
Environment=HOME=/home/ubuntu
# Point the dashboard at your own wildcard domain:
Environment=DEV_DOMAIN=dev.example.com
WorkingDirectory=/home/ubuntu/session-dashboard
ExecStart=/usr/bin/node app/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
